# ============================================
# Cardano Deploy Script Configuration
# ============================================

# Blockfrost Project ID for Cardano Preview Network
# Get your project ID from: https://blockfrost.io/
# Format: previewXXXXXXXXXXXXXXXXXXXXXXXX
BLOCKFROST_PROJECT_ID=your_blockfrost_project_id_here

# ============================================
# Wallet Authentication (Choose ONE method)
# ============================================

# RECOMMENDED: Use a seed phrase (24 words mnemonic)
# This is the recovery phrase from your wallet (Nami, Eternl, Daedalus, etc.)
# Or generate a new one by running: bun run generate-wallet.ts
SEED_PHRASE=your 24 word seed phrase goes here

# ADVANCED: Raw hex private key (64 or 128 characters)
# Only use this if you have the raw hex format (NOT xprv... format)
# Most users should use SEED_PHRASE instead
# PRIVATE_KEY=your_hex_private_key_here

# ============================================
# IMPORTANT NOTES:
# ============================================
# ✅ Use SEED_PHRASE - it's easier and more compatible
# ❌ Don't use xprv... format keys (Bech32) - not supported
# ⚠️  Never commit this file to git
# 🔒 Keep your credentials secret
# 🧪 Use testnet only for development
# 
# Need help? 
# - Generate wallet: bun run generate-wallet.ts
# - Get testnet ADA: https://docs.cardano.org/cardano-testnet/tools/faucet/
